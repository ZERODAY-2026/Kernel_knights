*.pdf
!samples/*.pdf
*.docx
*.doc
*.txt
!samples/*.txt
!tests/*.txt
!requirements.txt

# Distribution / packaging
build/
dist/
*.egg-info/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
