# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Environments & Virtualenvs
.venv/
venv/
ENV/
env/
.env
.env.*
!.env.example

# Test outputs & evaluation dumps
result*.json
offline.json
inj*.json
netcheck.txt
