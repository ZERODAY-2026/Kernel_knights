# Environment Configuration & Local Secrets Template
# The Legal Document Triage application runs 100% on-device.
# No remote cloud keys (e.g. OpenAI, Anthropic, AWS) are required by design.

# Local Ollama Host (Hardcoded to loopback for zero-cloud egress)
OLLAMA_HOST=http://127.0.0.1:11434

# Local Model Name
MODEL=gemma4:e4b

# Server Binding
API_HOST=127.0.0.1
API_PORT=8000
